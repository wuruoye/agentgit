{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh\"",
            "timeout": 8
          }
        ],
        "matcher": "^(Bash|exec_command|shell_command|shell|apply_patch|Write|Edit|MultiEdit|NotebookEdit)$"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh\"",
            "timeout": 10,
            "async": true
          }
        ],
        "matcher": "^(Bash|exec_command|shell_command|shell|apply_patch|Write|Edit|MultiEdit|NotebookEdit)$"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh\"",
            "timeout": 10,
            "async": true
          }
        ],
        "matcher": "^(Bash|exec_command|shell_command|shell|apply_patch|Write|Edit|MultiEdit|NotebookEdit)$"
      }
    ]
  }
}
