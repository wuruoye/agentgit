{
  "description": "Require AgentGit registration before Codex writes to a Git worktree.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/AgentGitHookBridge\" guard --provider codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
